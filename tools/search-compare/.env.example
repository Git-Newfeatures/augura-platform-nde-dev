# Copy to .env and fill in. The notebook loads this file automatically.
# .env is git-ignored — never commit real keys.

# --- Lane 1: PubMed (LLM-curated) -------------------------------------------
# REQUIRED for the answer synthesis. The PubMed search itself works without a key.
ANTHROPIC_API_KEY=

# OPTIONAL. PubMed/E-utilities works with no key at 3 req/s; a free NCBI key raises
# the limit to 10 req/s. Get one at https://www.ncbi.nlm.nih.gov/account/ (Settings →
# "API Key Management"). NCBI also asks you to identify your app:
NCBI_API_KEY=
NCBI_EMAIL=

# --- Lane 2: Consensus ------------------------------------------------------
# Access is application-gated: apply at https://consensus.app/home/api/
# Endpoint GET /v1/quick_search, sent with header  x-api-key: <key>
CONSENSUS_API_KEY=
# Override only if Consensus gives you a non-default base URL:
# CONSENSUS_API_BASE=https://api.consensus.app

# --- Lane 3: OpenEvidence ---------------------------------------------------
# No public API. Enterprise agreement + signed BAA required
# (sales@openevidence.com / https://www.openevidence.com/product/api).
# The request path and response field names are NOT officially published — set these to
# match the real spec you receive. The lane stays disabled until BASE + KEY are both set.
OPENEVIDENCE_API_BASE=
OPENEVIDENCE_API_KEY=
OPENEVIDENCE_ORG_ID=
# OPENEVIDENCE_SEARCH_PATH=/analysis
# OPENEVIDENCE_ANSWER_FIELD=answer
# OPENEVIDENCE_SOURCES_FIELD=references

#!/bin/sh
# commit-msg — retire automatiquement les trailers d'attribution IA des messages
# de commit (Claude / Anthropic / "Generated with Claude Code").
#
# Garde-fou anti-récidive : ces trailers ne doivent JAMAIS apparaître dans
# l'historique (cf. CLAUDE.md › Conventions). Les vrais Co-Authored-By humains
# sont préservés.
#
# Activation (une fois par clone) : git config core.hooksPath .githooks

msg_file="$1"
tmp="$msg_file.augura.tmp"

# 1) Supprime les lignes d'attribution IA (insensible à la casse).
grep -viE 'co-authored-by:[[:space:]]*claude|noreply@anthropic\.com|generated with \[?claude code' \
  "$msg_file" > "$tmp"

# 2) Retire les lignes vides résiduelles en fin de message.
awk '
  { lines[NR] = $0 }
  END {
    last = NR
    while (last > 0 && lines[last] ~ /^[[:space:]]*$/) last--
    for (i = 1; i <= last; i++) print lines[i]
  }
' "$tmp" > "$msg_file"

rm -f "$tmp"
exit 0

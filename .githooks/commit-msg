#!/bin/sh
# commit-msg — automatically strips AI-attribution trailers from commit
# messages (Claude / Anthropic / "Generated with Claude Code").
#
# Anti-recurrence safeguard: these trailers must NEVER appear in the
# history (see CLAUDE.md > Conventions). Genuine human Co-Authored-By lines
# are preserved.
#
# Activation (once per clone): git config core.hooksPath .githooks

msg_file="$1"
tmp="$msg_file.augura.tmp"

# 1) Remove AI-attribution lines (case-insensitive).
grep -viE 'co-authored-by:[[:space:]]*claude|noreply@anthropic\.com|generated with \[?claude code' \
  "$msg_file" > "$tmp"

# 2) Strip residual blank lines at the end of the message.
awk '
  { lines[NR] = $0 }
  END {
    last = NR
    while (last > 0 && lines[last] ~ /^[[:space:]]*$/) last--
    for (i = 1; i <= last; i++) print lines[i]
  }
' "$tmp" > "$msg_file"

rm -f "$tmp"
exit 0

# apps/api — backend configuration (AUGURA_ prefix). Copy to .env and fill in.
AUGURA_ENV=dev
AUGURA_LOG_LEVEL=INFO

# Database — Supabase project Augura_Prod_Test.
# Connect via the dedicated NON superuser role `augura_api` (RLS enforced, spec §7).
# Set its password first:  alter role augura_api with password '<choose>';
# Direct (persistent backend):
AUGURA_DATABASE_URL=postgresql+asyncpg://augura_api:<PASSWORD>@db.fqmoylmvjoafihiuiiuj.supabase.co:5432/postgres
# (serverless alternative: session pooler aws-0-<region>.pooler.supabase.com:5432)

# CORS — allowed frontend origins (comma-separated list). Default:
# localhost:5173 (vite dev). In prod: the apps/web domain.
# AUGURA_CORS_ORIGINS=https://app.augura.io

# Supabase Auth — asymmetric keys (ES256) ⇒ verification via JWKS.
AUGURA_SUPABASE_JWKS_URL=https://fqmoylmvjoafihiuiiuj.supabase.co/auth/v1/.well-known/jwks.json
AUGURA_SUPABASE_JWT_AUDIENCE=authenticated
AUGURA_SUPABASE_JWT_ISSUER=https://fqmoylmvjoafihiuiiuj.supabase.co/auth/v1

# Supabase Storage (object store) for uploaded dataset bytes. REQUIRED in prod:
# Modal's disk is ephemeral AND per-container, so a file written by one container is
# not re-readable by the one that reprofiles on add/remove. Without these, core.storage
# falls back to local disk → add/remove a file 500s ("Failed to fetch" in the browser).
# The service_role key bypasses Storage RLS — backend secret only, NEVER the frontend.
AUGURA_SUPABASE_URL=https://fqmoylmvjoafihiuiiuj.supabase.co
AUGURA_SUPABASE_SERVICE_ROLE_KEY=
AUGURA_STORAGE_BUCKET=datasets

# LLM (agents) — required for a live agent run.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# apps/api — configuration backend (préfixe AUGURA_). Copier en .env et compléter.
AUGURA_ENV=dev
AUGURA_LOG_LEVEL=INFO

# Base de données — projet Supabase Augura_Prod_Test.
# Connexion via le rôle dédié NON superuser `augura_api` (RLS appliquée, spec §7).
# Poser d'abord son mot de passe :  alter role augura_api with password '<choisir>';
# Direct (backend persistant) :
AUGURA_DATABASE_URL=postgresql+asyncpg://augura_api:<PASSWORD>@db.fqmoylmvjoafihiuiiuj.supabase.co:5432/postgres
# (alternative serverless : session pooler aws-0-<region>.pooler.supabase.com:5432)

# Auth Supabase — clés asymétriques (ES256) ⇒ vérification via JWKS.
AUGURA_SUPABASE_JWKS_URL=https://fqmoylmvjoafihiuiiuj.supabase.co/auth/v1/.well-known/jwks.json
AUGURA_SUPABASE_JWT_AUDIENCE=authenticated
AUGURA_SUPABASE_JWT_ISSUER=https://fqmoylmvjoafihiuiiuj.supabase.co/auth/v1

# LLM (agents) — requis pour un run live des agents.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
